<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRootRacha"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_racha_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="16dp">

    <TextView
        android:id="@+id/widgetEmojiRacha"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/widget_emoji_circle"
        android:gravity="center"
        android:text="🔥"
        android:textSize="30sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widgetTituloRacha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans"
            android:text="Widget de racha"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widgetEstadoRacha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Informe de hoy completo"
            android:textColor="#7DD3FC"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widgetFraseRacha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:maxLines="2"
            android:text="Mañana volvé para mantenerla."
            android:textColor="#E0F2FE"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
